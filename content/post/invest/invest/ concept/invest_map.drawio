        <mxCell id="7BMURNTmZSGERhOQDvPO-6" value="&amp;nbsp; 股票比例(5-10支）" style="rounded=0;whiteSpace=wrap;html=1;container=0;fillColor=#f8cecc;strokeColor=#b85450;align=left;" parent="1" vertex="1">
          <mxGeometry x="1040" y="145" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bfy3ByjU3lHhN7pAhuGC-1" value="&lt;meta charset=&quot;utf-8&quot;&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;&lt;span style=&quot;font-weight: bold;&quot;&gt;总结为：&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;1. 长期投资（3-5年）；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;2. 分散持仓；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;3. 慎重对待每一次交易；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;4. 不要尝试预测股价走势；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;5. 保持耐心；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;6. 保持终生学习；&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 20px; line-height: 1.8; font-size: 14px; color: rgb(17, 17, 17); overflow-wrap: break-word; font-family: Helvetica, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot; data-page=&quot;0&quot;&gt;7. 避免经常看盘；&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
